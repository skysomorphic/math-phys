\makeatletter
\patchcmd\deferred@thm@head
{\addvspace{-\parskip}}
{}
{}{\typeout{\string\deferred@thm@head patch failed!}}
\makeatletter

% \setlength{\parindent}{0pt}

\renewcommand\qedsymbol{$\blacksquare$}

\newenvironment{sln}[1][Solution]{
\begin{proof}[\textbf{\textit{#1}}]}{
\end{proof}}

\newenvironment{pf}{
\begin{proof}}{
\end{proof}}

\theoremstyle{plain} % bold title, italic bodies
\newtheorem{thm}{Theorem}
\newtheorem{lm}[thm]{Lemma}
\newtheorem{conj}[thm]{Conjecture}
\newtheorem*{prop}{Proposition}

\newtheorem{cor}{Corollary}[thm] % resets counter per theorem
\newtheorem{claim}{Claim}[thm]

\theoremstyle{definition} % bold title, roman body
\newtheorem{defn}[thm]{Definition}
\newtheorem{ex}{Example}[thm]

\theoremstyle{remark} % italic title, roman body
\newtheorem*{remark}{Remark}
\newtheorem*{notation}{Notation}
\newtheorem*{note}{Note}
\newtheorem*{exercise}{Exercise}

% shortcuts
\newcommand{\ndiv}{\not\hspace{2.5pt}\mid}
\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}

\newcommand{\FF}{\mathbb{F}} % field

\newcommand{\ps}{\mathcal{P}}

% mathrm operators
\DeclareMathOperator{\opspan}{span}
